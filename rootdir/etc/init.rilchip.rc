# This is a common source of Android security bugs.
#

service sec_diag_uart_log /vendor/bin/sec_diag_uart_log
    class main
    user root
    group radio oem_2901 system

service SMD-daemon /vendor/bin/smdexe
    class main
    user root
    group system radio inet net_raw

service vendor.atfwd /vendor/bin/ATFWD-daemon
    class late_start
    user system
    group system radio

on property:persist.vendor.radio.atfwd.start=false
    stop vendor.atfwd

on property:vendor.radio.atfwd.start=false
    stop vendor.atfwd

